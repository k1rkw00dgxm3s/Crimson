---
import Layout from "../Layouts/Layout.astro";
---

<Layout title="Chat">
    <main id="chat-page">
        <section id="auth-panel" class="chat-panel">
            <p class="eyebrow">Cr1mson realtime</p>
            <h1>Chat room</h1>
            <p class="muted">Sign in to join the live #general room.</p>
            <form id="auth-form">
                <input id="auth-username" minlength="3" maxlength="32" placeholder="Username" autocomplete="username" required />
                <input id="auth-password" minlength="4" type="password" placeholder="Password" autocomplete="current-password" required />
                <button type="submit">Sign in</button>
            </form>
            <button id="auth-mode" class="text-button" type="button">Need an account? Sign up</button>
            <p id="auth-status" class="status"></p>
        </section>

        <section id="room-app" class="chat-panel hidden">
            <header class="chat-header">
                <div><p class="eyebrow">Signed in as <span id="current-user"></span></p><h1>#general</h1></div>
                <button id="sign-out" class="ghost-button">Sign out</button>
            </header>
            <section id="room-main">
                <div id="room-messages" aria-live="polite"></div>
                <form id="message-form"><input id="message-input" maxlength="500" placeholder="Write in #general..." autocomplete="off" required /><button aria-label="Send message" title="Send message"><svg viewBox="0 0 24 24"><path d="m4 4 16 8-16 8 3-8-3-8Zm3 8h13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button></form>
            </section>
            <p id="room-status" class="status"></p>
        </section>
    </main>
    <script src="../scripts/chatroom.ts"></script>
</Layout>

<style>
    #chat-page { min-height: 100vh; display: grid; place-items: center; padding: 1rem; color: #fff; background: linear-gradient(135deg, #160519, #4a092f); }
    .chat-panel { width: min(900px, 100%); border: 1px solid rgba(255,255,255,.16); border-radius: 18px; background: rgba(17,4,22,.84); box-shadow: 0 24px 70px rgba(0,0,0,.4); backdrop-filter: blur(18px); }
    #auth-panel { max-width: 460px; padding: 2rem; } h1 { margin: 0 0 .6rem; font-family: bold; } .eyebrow { margin: 0 0 .4rem; color: #f18ab8; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; } .muted, .status { color: rgba(255,255,255,.58); } .status { min-height: 1.2rem; margin: .7rem 0 0; padding: 0 1rem .8rem; font-size: .85rem; }
    form { display: grid; gap: .7rem; } input { min-width: 0; border: 1px solid rgba(255,255,255,.16); border-radius: 9px; padding: .75rem .85rem; color: #fff; background: rgba(255,255,255,.08); font: inherit; outline: none; } input:focus { border-color: #f18ab8; } button { border: 0; border-radius: 9px; padding: .75rem 1rem; color: #fff; background: #a92868; font: inherit; cursor: pointer; } button:hover { background: #d23b82; } .ghost-button { background: transparent; border: 1px solid rgba(255,255,255,.18); }
    .text-button { margin-top: .8rem; padding: 0; color: #f18ab8; background: transparent; font-size: .85rem; } .text-button:hover { background: transparent; text-decoration: underline; } .hidden { display: none !important; }
    .chat-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.4rem; border-bottom: 1px solid rgba(255,255,255,.1); } .chat-header h1 { margin: 0; }
    #room-main { display: grid; grid-template-rows: 1fr auto; min-height: 62vh; min-width: 0; } #room-messages { display: flex; flex-direction: column; gap: .7rem; overflow-y: auto; padding: 1.2rem; } .message { max-width: 78%; padding: .65rem .8rem; border-radius: 10px 10px 10px 2px; background: rgba(255,255,255,.07); } .message strong { display: block; color: #f18ab8; font-size: .8rem; } .message p { margin: .2rem 0 0; overflow-wrap: anywhere; } #message-form { display: grid; grid-template-columns: 1fr 3rem; padding: 1rem; border-top: 1px solid rgba(255,255,255,.1); } #message-form button { display: grid; place-items: center; padding: .5rem; } #message-form svg { width: 1.2rem; height: 1.2rem; }
    @media (max-width: 600px) { #chat-page { padding: .75rem; } #room-main { min-height: 72vh; } }
</style>
