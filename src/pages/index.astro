---
import Layout from "../Layouts/Layout.astro";
import Background from "../components/background.astro";
import time from "../scripts/time.ts";
---

<Layout title="Home" proxy={true}>
	<main>
		<Background />

		<div id="content">
			<div id="top-wrapper">
				<div id="top">
					<img
						id="main-logo"
						src="https://pictureurl.com/api/storage/file?key=u%2Fanon%2F00a3194f-a300-467c-86fb-cbbf8432f35c-Crimson-9-11-2026.png"
						alt="Cr1mson"
					/>
					<h3 id="time">{time}</h3>
				</div>
				<div id="bottom">
					<div id="searchbar">
						<form id="search-form" method="POST">
							<button type="submit">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path
										d="M21 21L15.0001 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</button>
							<input type="text" name="q" placeholder="Search" />
						</form>
					</div>
					<nav id="shortcuts" aria-label="Proxy shortcuts">
						<a class="proxy-shortcut" href="https://www.tiktok.com" data-url="https://www.tiktok.com" aria-label="Open TikTok in the proxy">
							<img src="https://cdn.jsdelivr.net/npm/simple-icons@16.30.0/icons/tiktok.svg" alt="" />
						</a>
						<a class="proxy-shortcut" href="https://www.instagram.com" data-url="https://www.instagram.com" aria-label="Open Instagram in the proxy">
							<img src="https://cdn.jsdelivr.net/npm/simple-icons@16.30.0/icons/instagram.svg" alt="" />
						</a>
						<a class="proxy-shortcut" href="https://www.facebook.com" data-url="https://www.facebook.com" aria-label="Open Facebook in the proxy">
							<img src="https://cdn.jsdelivr.net/npm/simple-icons@16.30.0/icons/facebook.svg" alt="" />
						</a>
						<a class="proxy-shortcut" href="https://www.snapchat.com" data-url="https://www.snapchat.com" aria-label="Open Snapchat in the proxy">
							<img src="https://cdn.jsdelivr.net/npm/simple-icons@16.30.0/icons/snapchat.svg" alt="" />
						</a>
						<a class="proxy-shortcut" href="https://www.google.com" data-url="https://www.google.com" aria-label="Google" title="Google">
							<img src="https://cdn.jsdelivr.net/npm/simple-icons@16.30.0/icons/google.svg" alt="Google" />
						</a>
						<a class="proxy-shortcut" href="/chat" data-url="/chat" data-internal="true" data-title="Chat" aria-label="Chat" title="Chat">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.8-.9L4 19l1.1-3.2A7.3 7.3 0 0 1 4.5 12 7.5 7.5 0 0 1 12 4.5a7.5 7.5 0 0 1 8 7Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</a>
						<a class="proxy-shortcut" href="/games" data-url="/games" data-internal="true" data-title="Games" aria-label="Games" title="Games">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8.5 9-1.2 1.2M7.3 10.2H5.8M15.5 9l1.2 1.2M16.7 10.2h1.5M9 16.5c-1.4 1.7-3.5 2.4-4.5.8-1-1.5-.3-4.3.8-6.8C6.4 7.8 8.6 6.5 12 6.5s5.6 1.3 6.7 4c1.1 2.5 1.8 5.3.8 6.8-1 1.6-3.1.9-4.5-.8-.8-1-1.7-1.5-3-1.5s-2.2.5-3 1.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</a>
					</nav>
				</div>
			</div>
			<div id="bottom-wrapper"></div>
		</div>
	</main>
	<script src="../scripts/time.ts"></script>
	<script src="../scripts/index.ts"></script>
	<script src="../scripts/global.ts"></script>
</Layout>
