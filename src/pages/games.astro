---
import Layout from "../Layouts/Layout.astro";
---

<Layout title="Games">
    <main id="lumin-games">
        <div id="games"></div>
    </main>
    <script src="https://cdn.jsdelivr.net/gh/luminsdk/script@latest/lumin.min.js"></script>
    <script>
        window.addEventListener("load", () => {
            if (window.Lumin) window.Lumin.init({ container: "#games", theme: "light" });
        });
    </script>
</Layout>

<style>
    #lumin-games { min-height: 100vh; padding: 20px; background: #fff; color: #121212; font-family: Arial, sans-serif; }
    #games { max-width: 1200px; margin: 0 auto; }
</style>
